#!/bin/sh
# Enforces the project commit convention: type(#issue): message
# Documented in AGENTS.md > "Project tracking and Git workflow".
# Enable once per clone with: git config core.hooksPath .githooks

pattern='^(feat|fix|docs|test|refactor|chore|build|ci|perf|style)\(#[0-9]+\): .+'
first_line=$(head -n 1 "$1")

# Let git's own generated messages through (merge, revert, fixup, squash).
case "$first_line" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*) exit 0 ;;
esac

if printf '%s' "$first_line" | grep -Eq "$pattern"; then
  exit 0
fi

cat >&2 <<'MSG'
✗ Mensagem de commit fora do padrão do projeto.

  Padrão:  tipo(#issue): mensagem
  Tipos:   feat fix docs test refactor chore build ci perf style

  Exemplos:
    feat(#15): restrict story points to the Fibonacci scale
    fix(#8): reject moving a story to another project's backlog
    docs(#31): document the acceptance_criteria table

Toda mudança nasce de uma issue — veja AGENTS.md.
MSG
exit 1
