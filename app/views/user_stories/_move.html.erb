<% destinations = project.backlogs.where.not(id: story.backlog_id).order(:kind, :starts_on, :id) %>
<% if destinations.any? %>
  <%= form_with url: project_user_story_move_path(project, story), class: "mt-4 flex flex-wrap items-end gap-2" do |form| %>
    <div>
      <%= form.label :backlog_id, "Mover para", class: "block text-sm font-medium" %>
      <%= form.select :backlog_id, destinations.map { |backlog| [ backlog.name, backlog.id ] }, {},
            class: "mt-1 shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2" %>
    </div>
    <%= form.submit "Mover", class: "rounded-md px-3 py-2 border border-gray-300 hover:bg-gray-50 font-medium cursor-pointer" %>
  <% end %>
<% end %>
