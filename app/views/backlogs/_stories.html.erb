<%# Histórias de um backlog, no formato padrão "Como um … eu quero … para …". %>
<% if stories.any? %>
  <ul class="mt-3 divide-y divide-gray-200 rounded-md border border-gray-200">
    <% stories.each do |story| %>
      <li id="<%= dom_id(story) %>" class="p-3 break-words"><%= story %></li>
    <% end %>
  </ul>
<% else %>
  <p class="mt-3 text-sm text-gray-600">Nenhuma história neste backlog.</p>
<% end %>
