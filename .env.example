# Copie para .env e preencha. O .env é ignorado pelo git.
#
# Nunca commite credenciais reais — nem as de desenvolvimento. Este arquivo
# documenta as chaves necessárias, não os valores.

POSTGRES_USER=okonomi
POSTGRES_DB=okonomi_development
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Gere uma senha local, por exemplo com:  openssl rand -hex 16
POSTGRES_PASSWORD=
