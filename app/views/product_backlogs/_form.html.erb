<%= form_with model: backlog, scope: :backlog, url: project_product_backlog_path(project),
      method: backlog.persisted? ? :patch : :post, class: "contents" do |form| %>
  <%= render "shared/form_errors", model: backlog %>

  <div class="my-5">
    <%= form.label :name, class: "font-medium" %>
    <%= form.text_field :name, required: true, autofocus: true, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="my-5">
    <%= form.label :goal, class: "font-medium" %>
    <%= form.text_area :goal, rows: 3, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="flex flex-wrap items-center gap-4">
    <%= form.submit backlog.persisted? ? "Salvar product backlog" : "Criar product backlog",
          class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
    <%= link_to "Cancelar", project, class: "text-gray-700 underline hover:no-underline" %>
  </div>
<% end %>
