<% content_for :title, "#{@project.name} · okonomi" %>

<nav class="text-sm text-gray-600" aria-label="Trilha">
  <%= link_to "Meus projetos", projects_path, class: "underline hover:no-underline" %>
</nav>

<div class="mt-2 flex flex-wrap items-start justify-between gap-3">
  <div class="min-w-0">
    <h1 class="font-bold text-3xl break-words"><%= @project.name %></h1>
    <% if @project.description.present? %>
      <p class="mt-2 text-gray-600 break-words"><%= @project.description %></p>
    <% end %>
  </div>

  <div class="flex flex-wrap items-center gap-2">
    <%= link_to "Editar", edit_project_path(@project), class: "rounded-md px-3 py-2 border border-gray-300 hover:bg-gray-50 font-medium" %>
    <%= button_to "Excluir projeto", @project, method: :delete,
          form: { data: { turbo_confirm: "Excluir o projeto e tudo o que ele contém?" } },
          class: "rounded-md px-3 py-2 bg-red-600 hover:bg-red-500 text-white font-medium cursor-pointer" %>
  </div>
</div>

<%= render "product_backlog", project: @project %>

<%= render "sprint_backlogs", project: @project %>
