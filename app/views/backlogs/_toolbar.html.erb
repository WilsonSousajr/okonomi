<%# Filtro das histórias do backlog por etiqueta MoSCoW (#16), via GET para manter o link compartilhável. %>
<%= form_with url: path, method: :get, class: "mt-3 flex flex-wrap items-end gap-2" do |form| %>
  <div>
    <%= form.label :moscow, "MoSCoW", class: "block text-sm font-medium" %>
    <%= form.select :moscow, moscow_options, { include_blank: "Todas", selected: params[:moscow] },
          class: "mt-1 shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-1.5 text-sm" %>
  </div>
  <%= form.submit "Filtrar", name: nil, class: "rounded-md px-3 py-1.5 border border-gray-300 hover:bg-gray-50 text-sm font-medium cursor-pointer" %>
<% end %>
