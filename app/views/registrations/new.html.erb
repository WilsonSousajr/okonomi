<% content_for :title, "Criar conta · okonomi" %>

<div class="mx-auto w-full md:w-2/3">
  <h1 class="font-bold text-4xl">Criar conta</h1>

  <%= form_with model: @user, url: registration_path, class: "contents" do |form| %>
    <div class="my-5">
      <%= render "shared/form_errors", model: @user %>
    </div>

    <div class="my-5">
      <%= form.label :email_address, class: "font-medium" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "seu@email.com", class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= form.label :password, class: "font-medium" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 8, maxlength: 72, aria: { describedby: "password_hint" }, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
      <p id="password_hint" class="mt-1 text-sm text-gray-500">Mínimo de 8 caracteres.</p>
    </div>

    <div class="my-5">
      <%= form.label :password_confirmation, class: "font-medium" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="sm:flex sm:items-center sm:gap-4">
      <%= form.submit "Criar conta", class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>

      <div class="mt-4 text-sm text-gray-500 sm:mt-0">
        Já tem conta? <%= link_to "Entrar", new_session_path, class: "text-gray-700 underline hover:no-underline" %>
      </div>
    </div>
  <% end %>
</div>
