<% content_for :title, "Meus projetos · okonomi" %>

<div class="flex flex-wrap items-center justify-between gap-3">
  <h1 class="font-bold text-3xl">Meus projetos</h1>
  <%= link_to "Novo projeto", new_project_path, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium" %>
</div>

<div id="projects" class="mt-6">
  <% if @projects.any? %>
    <ul class="divide-y divide-gray-200 rounded-md border border-gray-200">
      <% @projects.each do |project| %>
        <li id="<%= dom_id(project) %>" class="p-4">
          <%= link_to project.name, project, class: "font-semibold text-blue-700 hover:underline" %>
          <% if project.description.present? %>
            <p class="mt-1 text-sm text-gray-600 break-words"><%= project.description %></p>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-gray-600">Você ainda não tem projetos. Crie o primeiro para começar.</p>
  <% end %>
</div>
