<section id="product_backlog" class="mt-8" aria-labelledby="product_backlog_title">
  <% if (backlog = project.product_backlog) %>
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 id="product_backlog_title" class="font-semibold text-2xl break-words"><%= backlog.name %></h2>
      <div class="flex flex-wrap items-center gap-2">
        <%= link_to "Nova história", new_project_user_story_path(project), class: "rounded-md px-3 py-1.5 bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium" %>
        <%= link_to "Editar", edit_project_product_backlog_path(project), class: "rounded-md px-3 py-1.5 border border-gray-300 hover:bg-gray-50 text-sm font-medium" %>
        <%= button_to "Excluir", project_product_backlog_path(project), method: :delete,
              form: { data: { turbo_confirm: "Excluir o product backlog e as histórias dele?" } },
              class: "rounded-md px-3 py-1.5 border border-red-300 text-red-700 hover:bg-red-50 text-sm font-medium cursor-pointer" %>
      </div>
    </div>
    <% if backlog.goal.present? %>
      <p class="mt-1 text-gray-600 break-words"><%= backlog.goal %></p>
    <% end %>
    <%= render "backlogs/points_total", stories: backlog.user_stories %>
    <%= render "backlogs/toolbar", path: project_path(project) %>
    <%= render "backlogs/stories", stories: backlog_stories(backlog) %>
  <% else %>
    <h2 id="product_backlog_title" class="font-semibold text-2xl">Product backlog</h2>
    <p class="mt-2 text-gray-600">Este projeto ainda não tem product backlog.</p>
    <%= link_to "Criar product backlog", new_project_product_backlog_path(project),
          class: "mt-3 inline-block rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium" %>
  <% end %>
</section>
