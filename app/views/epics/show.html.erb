<% content_for :title, "#{@epic.title} · okonomi" %>

<nav class="text-sm text-gray-600" aria-label="Trilha">
  <%= link_to "Meus projetos", projects_path, class: "underline hover:no-underline" %> ›
  <%= link_to @project.name, @project, class: "underline hover:no-underline" %>
</nav>

<div class="mt-2 flex flex-wrap items-start justify-between gap-3">
  <div class="min-w-0">
    <h1 class="font-bold text-3xl break-words"><%= @epic.title %></h1>
    <% if @epic.description.present? %>
      <p class="mt-2 text-gray-600 break-words"><%= @epic.description %></p>
    <% end %>
  </div>

  <div class="flex flex-wrap items-center gap-2">
    <%= link_to "Editar", edit_project_epic_path(@project, @epic), class: "rounded-md px-3 py-2 border border-gray-300 hover:bg-gray-50 font-medium" %>
    <%= button_to "Excluir épico", project_epic_path(@project, @epic), method: :delete,
          form: { data: { turbo_confirm: "Excluir o épico? As histórias dele continuam existindo, sem épico." } },
          class: "rounded-md px-3 py-2 bg-red-600 hover:bg-red-500 text-white font-medium cursor-pointer" %>
  </div>
</div>

<section id="epic_stories" class="mt-6" aria-labelledby="epic_stories_title">
  <div class="flex flex-wrap items-baseline justify-between gap-3">
    <h2 id="epic_stories_title" class="font-semibold text-2xl">Histórias do épico</h2>
    <p class="text-gray-600">
      Total: <span data-field="points_total"><%= pluralize(@epic.user_stories.sum(:story_points), "ponto", plural: "pontos") %></span>
    </p>
  </div>
  <%= render "backlogs/stories", stories: @epic.user_stories.order(:id) %>
</section>
