<%= form_with model: epic,
      url: epic.persisted? ? project_epic_path(project, epic) : project_epics_path(project),
      class: "contents" do |form| %>
  <%= render "shared/form_errors", model: epic %>

  <div class="my-5">
    <%= form.label :title, class: "font-medium" %>
    <%= form.text_field :title, required: true, autofocus: true, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="my-5">
    <%= form.label :description, class: "font-medium" %>
    <%= form.text_area :description, rows: 3, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="flex flex-wrap items-center gap-4">
    <%= form.submit epic.persisted? ? "Salvar épico" : "Criar épico",
          class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
    <%= link_to "Cancelar", epic.persisted? ? project_epic_path(project, epic) : project,
          class: "text-gray-700 underline hover:no-underline" %>
  </div>
<% end %>
