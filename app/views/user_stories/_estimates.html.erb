<%# MoSCoW, story points e pontuação RICE da história (#7); "—" quando ainda não definidos. %>
<dl class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-gray-600">
  <div class="flex gap-1"><dt>MoSCoW:</dt><dd data-field="moscow" class="font-medium text-gray-900"><%= story.moscow || "—" %></dd></div>
  <div class="flex gap-1"><dt>Story points:</dt><dd data-field="story_points" class="font-medium text-gray-900"><%= story.story_points || "—" %></dd></div>
  <div class="flex gap-1"><dt>RICE:</dt><dd data-field="rice" class="font-medium text-gray-900"><%= story.rice_score ? number_with_precision(story.rice_score, precision: 2) : "—" %></dd></div>
</dl>
