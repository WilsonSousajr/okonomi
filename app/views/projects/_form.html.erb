<%= form_with model: project, class: "contents" do |form| %>
  <%= render "shared/form_errors", model: project %>

  <div class="my-5">
    <%= form.label :name, class: "font-medium" %>
    <%= form.text_field :name, required: true, autofocus: true, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="my-5">
    <%= form.label :description, class: "font-medium" %>
    <%= form.text_area :description, rows: 4, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="flex flex-wrap items-center gap-4">
    <%= form.submit class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
    <%= link_to "Cancelar", project.persisted? ? project : projects_path, class: "text-gray-700 underline hover:no-underline" %>
  </div>
<% end %>
