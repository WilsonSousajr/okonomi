%% Diagrama físico do banco do okonomi (artefato 7, #31). Gerado a partir de db/schema.rb.
%% Renderizar: npx -y @mermaid-js/mermaid-cli@11.4.2 -i docs/BANCO-DE-DADOS/der.mmd -o docs/BANCO-DE-DADOS/der.png -w 1600 -b white
erDiagram
  users ||--o{ sessions : "possui"
  users ||--o{ projects : "é dono de"
  projects ||--o{ backlogs : "contém (1 product + N sprint)"
  projects ||--o{ epics : "agrupa"
  projects ||--o{ user_stories : "contém"
  backlogs ||--o{ user_stories : "FK composta (project_id, backlog_id)"
  epics |o--o{ user_stories : "FK composta (project_id, epic_id)"
  user_stories ||--o{ acceptance_criteria : "tem"

  users {
    bigint id PK
    string email_address UK "not null"
    string password_digest "not null, bcrypt"
    datetime created_at
    datetime updated_at
  }
  sessions {
    bigint id PK
    bigint user_id FK "not null"
    string ip_address
    string user_agent
    datetime created_at
    datetime updated_at
  }
  projects {
    bigint id PK
    bigint user_id FK "not null"
    string name "not null"
    text description
    datetime created_at
    datetime updated_at
  }
  backlogs {
    bigint id PK
    bigint project_id FK "not null"
    string kind "product | sprint"
    string name "not null"
    text goal
    date starts_on
    date ends_on "CHECK >= starts_on"
    datetime created_at
    datetime updated_at
  }
  epics {
    bigint id PK
    bigint project_id FK "not null"
    string title "not null"
    text description
    datetime created_at
    datetime updated_at
  }
  user_stories {
    bigint id PK
    bigint project_id FK "not null"
    bigint backlog_id FK "not null"
    bigint epic_id FK "nullable"
    text role "Como um"
    text action "eu quero"
    text benefit "para"
    integer story_points "CHECK Fibonacci"
    string moscow "CHECK M S C W"
    integer rice_reach "CHECK >= 0"
    decimal rice_impact "decimal(3,2)"
    integer rice_confidence "CHECK 100 80 50"
    integer rice_effort "CHECK Fibonacci"
    datetime created_at
    datetime updated_at
  }
  acceptance_criteria {
    bigint id PK
    bigint user_story_id FK "not null"
    text context "Dado"
    text action "quando"
    text outcome "então"
    datetime created_at
    datetime updated_at
  }
