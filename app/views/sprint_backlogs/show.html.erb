<% content_for :title, "#{@backlog.name} · okonomi" %>

<nav class="text-sm text-gray-600" aria-label="Trilha">
  <%= link_to "Meus projetos", projects_path, class: "underline hover:no-underline" %> ›
  <%= link_to @project.name, @project, class: "underline hover:no-underline" %>
</nav>

<div class="mt-2 flex flex-wrap items-start justify-between gap-3">
  <div class="min-w-0">
    <h1 class="font-bold text-3xl break-words"><%= @backlog.name %></h1>
    <%= render "period", backlog: @backlog %>
    <% if @backlog.goal.present? %>
      <p class="mt-2 text-gray-600 break-words"><%= @backlog.goal %></p>
    <% end %>
  </div>

  <div class="flex flex-wrap items-center gap-2">
    <%= link_to "Editar", edit_project_sprint_backlog_path(@project, @backlog), class: "rounded-md px-3 py-2 border border-gray-300 hover:bg-gray-50 font-medium" %>
    <%= button_to "Excluir sprint", project_sprint_backlog_path(@project, @backlog), method: :delete,
          form: { data: { turbo_confirm: "Excluir a sprint? As histórias dela voltam para o product backlog." } },
          class: "rounded-md px-3 py-2 bg-red-600 hover:bg-red-500 text-white font-medium cursor-pointer" %>
  </div>
</div>

<section class="mt-6" aria-label="Histórias da sprint">
  <%= render "backlogs/points_total", stories: @backlog.user_stories %>
  <%= render "backlogs/toolbar", path: project_sprint_backlog_path(@project, @backlog) %>
  <%= render "backlogs/stories", stories: backlog_stories(@backlog) %>
</section>
