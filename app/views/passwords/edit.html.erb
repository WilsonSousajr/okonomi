<% content_for :title, "Redefinir senha · okonomi" %>

<div class="mx-auto w-full md:w-2/3">
  <h1 class="font-bold text-4xl">Redefinir senha</h1>

  <%= form_with url: password_path(params[:token]), method: :put, class: "contents" do |form| %>
    <div class="my-5">
      <%= form.label :password, "Nova senha", class: "font-medium" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 8, maxlength: 72, aria: { describedby: "password_hint" }, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-solid focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
      <p id="password_hint" class="mt-1 text-sm text-gray-500">Mínimo de 8 caracteres.</p>
    </div>

    <div class="my-5">
      <%= form.label :password_confirmation, "Repita a nova senha", class: "font-medium" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-solid focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <%= form.submit "Salvar", class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  <% end %>
</div>
