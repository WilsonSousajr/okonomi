<% content_for :title, "okonomi" %>

<div class="mx-auto w-full md:w-2/3">
  <h1 class="font-bold text-4xl">okonomi</h1>

  <p class="mt-4 text-gray-600">
    Gestão de requisitos em projetos que usam histórias de usuário.
  </p>

  <p class="mt-8 text-sm text-gray-500">
    Esqueleto da aplicação. As funcionalidades são entregues pelos requisitos
    funcionais RF01 a RF19 — ver o quadro do projeto.
  </p>

  <div class="mt-8">
    <% if authenticated? %>
      <%= button_to "Sair", session_path, method: :delete,
            class: "rounded-md px-3.5 py-2.5 bg-gray-800 hover:bg-gray-700 text-white font-medium cursor-pointer" %>
    <% else %>
      <%= link_to "Entrar", new_session_path,
            class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium inline-block" %>
    <% end %>
  </div>
</div>
